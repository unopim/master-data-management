{
    "name": "unopim/master-data-management",
    "description": "Master Data Management (MDM) for UnoPim: governed master records, matching, approvals and code lists, alongside UnoPim PIM or standalone.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UnoPim",
            "email": "support@webkul.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\MasterDataManagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkul\\MasterDataManagement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\MasterDataManagement\\Providers\\MasterDataServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
