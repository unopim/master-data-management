{
    "name": "unopim/master-data-management",
    "description": "Open-source Master Data Management (MDM) for UnoPim: governed golden records, matching and merging, survivorship, cross-references, code lists, approvals and a REST API. Runs alongside UnoPim PIM or standalone.",
    "type": "library",
    "keywords": [
        "unopim",
        "mdm",
        "master-data",
        "master-data-management",
        "golden-record",
        "data-governance",
        "data-quality",
        "reference-data",
        "entity-resolution",
        "deduplication",
        "laravel",
        "pim"
    ],
    "homepage": "https://github.com/unopim/master-data-management",
    "license": "MIT",
    "authors": [
        {
            "name": "UnoPim",
            "email": "support@webkul.com"
        }
    ],
    "support": {
        "issues": "https://github.com/unopim/master-data-management/issues",
        "source": "https://github.com/unopim/master-data-management",
        "docs": "https://devdocs.unopim.com/",
        "email": "support@webkul.com",
        "security": "https://github.com/unopim/master-data-management/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.4",
        "azure-oss/storage-blob-laravel": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\MasterDataManagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkul\\MasterDataManagement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\MasterDataManagement\\Providers\\MasterDataServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
